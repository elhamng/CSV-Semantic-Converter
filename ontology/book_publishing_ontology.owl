<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/book_publishing_ontology"
         xmlns="http://example.org/book_publishing_ontology#">

<owl:Ontology rdf:about="http://example.org/book_publishing_ontology"/>

<owl:ObjectProperty rdf:about="#writes">
  <rdfs:domain rdf:resource="#Author"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#collaborates_with">
  <rdfs:domain rdf:resource="#Author"/>
  <rdfs:range rdf:resource="#Author"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#publishes">
  <rdfs:domain rdf:resource="#Publisher"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#publishes_book">
  <rdfs:domain rdf:resource="#Publisher"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#has_author">
  <rdfs:domain rdf:resource="#Book"/>
  <rdfs:range rdf:resource="#Author"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#has_publisher">
  <rdfs:domain rdf:resource="#Book"/>
  <rdfs:range rdf:resource="#Publisher"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#has_name">
  <rdfs:domain rdf:resource="#Author"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_birthdate">
  <rdfs:domain rdf:resource="#Author"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_email">
  <rdfs:domain rdf:resource="#Author"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_affiliation">
  <rdfs:domain rdf:resource="#Author"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_publisher_name">
  <rdfs:domain rdf:resource="#Publisher"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_established_year">
  <rdfs:domain rdf:resource="#Publisher"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_location">
  <rdfs:domain rdf:resource="#Publisher"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_website">
  <rdfs:domain rdf:resource="#Publisher"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_title">
  <rdfs:domain rdf:resource="#Book"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_publication_date">
  <rdfs:domain rdf:resource="#Book"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_ISBN">
  <rdfs:domain rdf:resource="#Book"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Author">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Publisher">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Book">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>


</rdf:RDF>
