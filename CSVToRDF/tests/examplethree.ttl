@prefix : <http://data.example.com#> .
@prefix onto: <http://purl.org/onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ExampleThree_1 a onto:SomeRole ;
    rdfs:label "1"^^xsd:string .

:Period_1_1 a onto:Period ;
    onto:definedBy :Thing2_1 ;
    onto:eindDatum "2022-01-10"^^xsd:date ;
    onto:hasArtifact :Thing1_1 ;
    onto:hasHours 120.0 ;
    onto:hasParticipant :Thing3_1 ;
    onto:startDatum "2022-01-01"^^xsd:date .

<http://purl.org/ozo/onz-g/dag2022-01-01> a time:Instant ;
    time:inTemporalPosition [ a time:TimePosition ;
            time:numericPosition 8036 ] ;
    time:inXSDDate "2022-01-01"^^xsd:date .

<http://purl.org/ozo/onz-g/dag2022-01-10> a time:Instant ;
    time:inTemporalPosition [ a time:TimePosition ;
            time:numericPosition 8045 ] ;
    time:inXSDDate "2022-01-10"^^xsd:date .

:thing4_1_1 a onto:ThingFour ;
    rdfs:label "1_1"^^xsd:string ;
    onto:eindDatum "2022-01-10"^^xsd:date ;
    onto:isAbout :Thing2_1,
        :Thing3_1 ;
    onto:startDatum "2022-01-01"^^xsd:date .

:Thing2_1 a onto:Thingtwo ;
    rdfs:label "1"^^xsd:string ;
    onto:hasPart :thing4_1_1 .

